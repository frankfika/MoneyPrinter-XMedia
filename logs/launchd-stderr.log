cron_runner_implementation:
  scripts:
    scripts/run-all-slots.sh: 顺序跑 5 个 slot 的入口
    scripts/scan-slot.sh: 单 slot 的 lite 扫描（mmx web search）
    scripts/launchd/com.codex.short-posts.scheduler.plist: macOS launchd 配置（每 slot
      触发 run-all-slots.sh）
  limitations:
    mmx_search_does_not_index_x: 'mmx 是通用 web 搜索，不支持 from: / site:x.com 准确过滤，X 反爬让多数
      x.com URL 不出现在搜索结果里 → scan-slot.sh 在多数 slot 会 found 0 candidate(s)'
    real_x_scan_needs_browser: 想真扫 X 时间线 + 抓实时浏览量，必须走 skills/hot-topic-tracker/SKILL.md
      描述的 browser use 路径（mcp__cua_repl__js + x.com/<handle>）
  install_hint_crontab: 0 9,12,15,18,21 * * *  cd /Users/fangchen/Documents/短文助手 &&
